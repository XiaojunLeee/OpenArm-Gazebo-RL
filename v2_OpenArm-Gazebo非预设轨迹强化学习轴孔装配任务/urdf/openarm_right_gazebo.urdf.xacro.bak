<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="openarm_right_hole_search">
  <xacro:include filename="$(find openarm_description)/assets/robot/openarm_v1.0/urdf/arm/openarm_arm.xacro"/>

  <xacro:property name="arm_cfg_root"
                  value="$(find openarm_description)/assets/robot/openarm_v1.0/config/arm"/>
  <xacro:property name="joint_limits" value="${xacro.load_yaml(arm_cfg_root + '/joint_limits.yaml')}"/>
  <xacro:property name="inertials" value="${xacro.load_yaml(arm_cfg_root + '/inertials.yaml')}"/>
  <xacro:property name="kinematics" value="${xacro.load_yaml(arm_cfg_root + '/kinematics.yaml')}"/>
  <xacro:property name="kinematics_link"
                  value="${xacro.load_yaml(arm_cfg_root + '/kinematics_link.yaml')}"/>
  <xacro:property name="kinematics_offset"
                  value="${xacro.load_yaml(arm_cfg_root + '/kinematics_offset.yaml')}"/>

  <link name="world"/>

  <xacro:openarm_arm
      arm_type="v10"
      arm_prefix="right_"
      no_prefix="false"
      description_pkg="openarm_description"
      connected_to="world"
      xyz="0 -0.031 0.698"
      rpy="1.5708 0 0"
      joint_limits="${joint_limits}"
      inertials="${inertials}"
      kinematics="${kinematics}"
      kinematics_link="${kinematics_link}"
      kinematics_offset="${kinematics_offset}"
      joint_damping="2.0"/>

  <!-- A 120 mm long, 6 mm diameter key/pin aligned with the tool +Z axis. -->
  <link name="openarm_right_search_tool">
    <visual>
      <origin xyz="0 0 0.06"/>
      <geometry><cylinder radius="0.003" length="0.12"/></geometry>
      <material name="tool_blue"><color rgba="0.1 0.35 0.9 1.0"/></material>
    </visual>
    <!-- Plate contact is represented by the controller's bounded virtual
         spring-damper. Keeping the 6 mm pin visual but omitting its rigid
         collision avoids unstable sub-millimetre sharp-edge impulses. -->
    <inertial>
      <origin xyz="0 0 0.06"/>
      <mass value="0.03"/>
      <inertia ixx="0.0000361" ixy="0" ixz="0"
               iyy="0.0000361" iyz="0" izz="0.000000135"/>
    </inertial>
  </link>
  <joint name="openarm_right_search_tool_joint" type="fixed">
    <parent link="openarm_right_link7"/>
    <child link="openarm_right_search_tool"/>
    <origin xyz="0 0 0"/>
  </joint>

  <link name="openarm_right_search_tool_tip"/>
  <joint name="openarm_right_search_tool_tip_joint" type="fixed">
    <parent link="openarm_right_search_tool"/>
    <child link="openarm_right_search_tool_tip"/>
    <origin xyz="0 0 0.12"/>
  </joint>

  <ros2_control name="openarm_right_gazebo_system" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:macro name="sim_joint" params="name initial">
      <joint name="${name}">
        <command_interface name="effort">
          <param name="min">-40</param>
          <param name="max">40</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${initial}</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </xacro:macro>
    <xacro:sim_joint name="openarm_right_joint1" initial="0.0"/>
    <xacro:sim_joint name="openarm_right_joint2" initial="1.15"/>
    <xacro:sim_joint name="openarm_right_joint3" initial="0.0"/>
    <xacro:sim_joint name="openarm_right_joint4" initial="1.30"/>
    <xacro:sim_joint name="openarm_right_joint5" initial="0.0"/>
    <xacro:sim_joint name="openarm_right_joint6" initial="0.0"/>
    <xacro:sim_joint name="openarm_right_joint7" initial="0.0"/>
  </ros2_control>

  <gazebo>
    <plugin filename="libgz_ros2_control-system.so"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find openarm_gazebo_hole_search)/config/controllers.yaml</parameters>
      <controller_manager_name>controller_manager</controller_manager_name>
    </plugin>
  </gazebo>

</robot>
